generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Conventions:
// - ids are UUID v7 (time-ordered, so they index well)
// - money is stored in cents and percentages in basis points (1000 = 10%), always integers
// - documents and phones are stored as digits only
// - every domain row belongs to a user, and every query filters by user_id

model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String   @db.VarChar(255)
  /// Always stored lowercase.
  email            String   @unique @db.VarChar(255)
  /// CPF, 11 digits. Optional: signup no longer asks for it (accounts from before have it).
  cpf              String?  @unique @db.Char(11)
  /// DDD + number, 10 or 11 digits. Optional, like the CPF.
  phone            String?  @db.VarChar(11)
  passwordHash     String   @map("password_hash")
  /// Can use the backoffice. Granted with `pnpm admin:grant <e-mail>` or by another admin.
  isAdmin          Boolean  @default(false) @map("is_admin")
  /// The user's customer at Stripe, created on the first checkout.
  stripeCustomerId String?  @unique @map("stripe_customer_id") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  properties      Property[]
  brokers         Broker[]
  bookings        Booking[]
  payments        Payment[]
  refreshTokens   RefreshToken[]
  /// Plans given to this user by an administrator.
  planGrants      PlanGrant[]      @relation("GrantBeneficiary")
  /// Grants this administrator made, and the actions they took on grants.
  grantsMade      PlanGrant[]      @relation("GrantAdmin")
  grantEvents     PlanGrantEvent[]
  subscriptions   Subscription[]
  billingPayments BillingPayment[]

  @@map("users")
}

enum PropertyType {
  HOUSE
  APARTMENT

  @@map("property_type")
}

model Property {
  id                 String       @id @default(uuid(7)) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  /// How the owner identifies the property, e.g. "Casa da praia".
  name               String       @db.VarChar(255)
  type               PropertyType
  /// CEP, 8 digits.
  zipCode            String?      @map("zip_code") @db.Char(8)
  /// UF, e.g. "SC".
  state              String?      @db.Char(2)
  city               String?      @db.VarChar(255)
  neighborhood       String?      @db.VarChar(255)
  street             String?      @db.VarChar(255)
  number             String?      @db.VarChar(20)
  complement         String?      @db.VarChar(255)
  /// Apartment only.
  building           String?      @db.VarChar(255)
  /// Apartment only.
  block              String?      @db.VarChar(50)
  /// Apartment only.
  unit               String?      @db.VarChar(20)
  /// Cents per night a new booking of this property starts with.
  defaultNightlyRate Int?         @map("default_nightly_rate")
  /// Cleaning fee, in cents, a new booking of this property starts with.
  defaultCleaningFee Int?         @map("default_cleaning_fee")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([id, userId])
  @@index([userId, name])
  @@map("properties")
}

enum BrokerType {
  INDIVIDUAL
  COMPANY

  @@map("broker_type")
}

model Broker {
  id                   String     @id @default(uuid(7)) @db.Uuid
  userId               String     @map("user_id") @db.Uuid
  type                 BrokerType
  name                 String     @db.VarChar(255)
  email                String?    @db.VarChar(255)
  /// CPF (11 digits) for INDIVIDUAL, CNPJ (14 characters, may be alphanumeric) for COMPANY.
  document             String?    @db.VarChar(14)
  mobilePhone          String?    @map("mobile_phone") @db.VarChar(11)
  landlinePhone        String?    @map("landline_phone") @db.VarChar(10)
  /// Commission, in basis points, a new booking with this broker starts with.
  defaultCommissionBps Int?       @map("default_commission_bps")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([id, userId])
  @@index([userId, name])
  @@map("brokers")
}

model Booking {
  id                  String   @id @default(uuid(7)) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  propertyId          String   @map("property_id") @db.Uuid
  brokerId            String?  @map("broker_id") @db.Uuid
  guestName           String   @map("guest_name") @db.VarChar(255)
  /// The guest's phone, digits only: DDD + 9 (mobile) or + 8 (landline).
  guestPhone          String?  @map("guest_phone") @db.VarChar(11)
  /// Free text: arrival time, how many people, anything worth remembering.
  notes               String?  @db.VarChar(2000)
  checkIn             DateTime @map("check_in") @db.Date
  checkOut            DateTime @map("check_out") @db.Date
  /// Cents.
  nightlyRate         Int      @map("nightly_rate")
  /// Cents.
  cleaningFee         Int      @default(0) @map("cleaning_fee")
  /// Cents, taken off the lodging total.
  discount            Int      @default(0)
  /// Cents already paid by the guest: always the sum of the booking's payments.
  amountPaid          Int      @default(0) @map("amount_paid")
  /// Basis points (1000 = 10%); only meaningful with a broker.
  brokerCommissionBps Int      @default(0) @map("broker_commission_bps")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction (checked at the end of the statement) instead of Restrict, so deleting a
  // user can still cascade through its bookings; deleting a property or broker that
  // has bookings fails either way.
  property Property @relation(fields: [propertyId, userId], references: [id, userId], onDelete: NoAction)
  broker   Broker?  @relation(fields: [brokerId, userId], references: [id, userId], onDelete: NoAction)

  payments Payment[]

  @@unique([id, userId])
  @@index([userId, checkOut])
  @@index([propertyId, checkIn])
  @@index([brokerId])
  @@map("bookings")
}

enum RefreshTokenRevocation {
  /// Replaced by a newer token of the same family on refresh.
  ROTATED
  /// The user logged out.
  LOGOUT
  /// A rotated token was presented again, so the whole family was revoked.
  REUSE_DETECTED

  @@map("refresh_token_revocation")
}

/// A login session's refresh token. Only its SHA-256 is stored. Each refresh replaces it
/// with a new token in the same family; presenting a ROTATED token again means it leaked,
/// so the whole family is revoked.
model RefreshToken {
  id               String                  @id @default(uuid(7)) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  /// SHA-256 of the token, hex.
  tokenHash        String                  @unique @map("token_hash") @db.Char(64)
  /// Shared by every token issued from the same login.
  familyId         String                  @map("family_id") @db.Uuid
  /// When this token stops working: a while after it was issued, never past the session's end.
  expiresAt        DateTime                @map("expires_at") @db.Timestamptz(3)
  /// The session's hard end, fixed at login and shared by the whole family.
  sessionExpiresAt DateTime                @map("session_expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?               @map("revoked_at") @db.Timestamptz(3)
  /// Set together with revokedAt.
  revokedReason    RefreshTokenRevocation? @map("revoked_reason")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// A payment received for a booking. The booking's amountPaid is the sum of these.
model Payment {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  /// Cents, more than zero.
  amount    Int
  /// The day it was received.
  paidOn    DateTime @map("paid_on") @db.Date
  /// E.g. "Sinal", "Pix", "Restante".
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Deleting a booking deletes its payments.
  booking Booking @relation(fields: [bookingId, userId], references: [id, userId], onDelete: Cascade)

  @@index([bookingId, paidOn])
  @@map("payments")
}

/// A commercial plan: what it allows and what it costs per billing period.
model Plan {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// Stable key of the plans the system relies on ("free", "premium"); null for plans an admin adds.
  code            String?  @unique @db.VarChar(50)
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(1000)
  /// Inactive plans can't be granted or bought; who has one keeps it until it ends.
  active          Boolean  @default(true)
  /// Properties a user on this plan may have; null means unlimited.
  maxProperties   Int?     @map("max_properties")
  /// Cents per month, per six months and per year; null while the period isn't offered.
  monthlyPrice    Int?     @map("monthly_price")
  semiannualPrice Int?     @map("semiannual_price")
  annualPrice     Int?     @map("annual_price")
  /// The plan's product at Stripe, created the first time someone subscribes to it.
  stripeProductId String?  @unique @map("stripe_product_id") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  grants      PlanGrant[]
  grantEvents PlanGrantEvent[]

  subscriptions Subscription[]

  @@map("plans")
}

/// How long a plan given by an administrator lasts.
enum GrantDuration {
  ONE_MONTH
  SIX_MONTHS
  ONE_YEAR
  LIFETIME
}

enum GrantAction {
  GRANTED
  RENEWED
  PLAN_CHANGED
  REVOKED
}

/// A plan an administrator gave a user, free of charge: a courtesy, never a payment.
model PlanGrant {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  planId      String        @map("plan_id") @db.Uuid
  /// The administrator who granted it; null if that account was deleted.
  grantedById String?       @map("granted_by_id") @db.Uuid
  duration    GrantDuration
  startsAt    DateTime      @map("starts_at") @db.Timestamptz(3)
  /// When it ends; null for a lifetime grant.
  endsAt      DateTime?     @map("ends_at") @db.Timestamptz(3)
  reason      String        @db.VarChar(500)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User             @relation("GrantBeneficiary", fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  grantedBy User?            @relation("GrantAdmin", fields: [grantedById], references: [id], onDelete: SetNull)
  events    PlanGrantEvent[]

  @@index([userId, revokedAt])
  @@map("plan_grants")
}

/// What happened to a grant, by whom and why: the backoffice's history.
model PlanGrantEvent {
  id       String         @id @default(uuid(7)) @db.Uuid
  grantId  String         @map("grant_id") @db.Uuid
  /// The administrator who acted; null if that account was deleted.
  actorId  String?        @map("actor_id") @db.Uuid
  action   GrantAction
  /// The plan and the end date as they were left by this action.
  planId   String         @map("plan_id") @db.Uuid
  endsAt   DateTime?      @map("ends_at") @db.Timestamptz(3)
  duration GrantDuration?
  reason   String         @db.VarChar(500)
  at       DateTime       @default(now()) @db.Timestamptz(3)

  grant PlanGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  actor User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  plan  Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([grantId, at])
  @@map("plan_grant_events")
}

/// How often a paid plan is charged.
enum BillingPeriod {
  MONTHLY
  SEMIANNUAL
  ANNUAL
}

/// A paid plan, charged by Stripe. Its status mirrors the Stripe subscription's, kept up to
/// date by Stripe's webhooks.
model Subscription {
  id                   String        @id @default(uuid(7)) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  planId               String        @map("plan_id") @db.Uuid
  period               BillingPeriod
  /// Stripe's status: active, past_due, canceled, incomplete, unpaid…
  status               String        @db.VarChar(30)
  stripeSubscriptionId String        @unique @map("stripe_subscription_id") @db.VarChar(255)
  /// When the period already paid ends (the next charge, or the end after a cancellation).
  currentPeriodEnd     DateTime?     @map("current_period_end") @db.Timestamptz(3)
  /// The renewal was cancelled: Premium lasts until currentPeriodEnd.
  cancelAtPeriodEnd    Boolean       @default(false) @map("cancel_at_period_end")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments BillingPayment[]

  @@index([userId, status])
  @@map("subscriptions")
}

/// A charge of a subscription, as Stripe reported it.
model BillingPayment {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  subscriptionId  String?  @map("subscription_id") @db.Uuid
  stripeInvoiceId String   @unique @map("stripe_invoice_id") @db.VarChar(255)
  /// Cents.
  amount          Int
  /// "paid" or "failed".
  status          String   @db.VarChar(20)
  at              DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, at])
  @@map("billing_payments")
}

/// Stripe events already handled: a webhook Stripe sends twice is applied once.
model StripeEvent {
  id         String   @id @db.VarChar(255)
  type       String   @db.VarChar(100)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("stripe_events")
}

/// Login attempts per e-mail, known or not, in the current window: against guessing one
/// account's password from many IP addresses. A successful login clears its row.
model LoginAttempt {
  email           String   @id @db.VarChar(254)
  attempts        Int
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)

  @@index([windowStartedAt])
  @@map("login_attempts")
}
